<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>0.29.0</AssemblyVersion>
    <FileVersion>0.29.0</FileVersion>
    <Version>0.29.0</Version>
    <ApplicationIcon>Assets\MSDesk.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <!-- MUSS gesetzt bleiben: sonst legt der Einzeldatei-Build die nativen
         WPF-Bibliotheken (PresentationNative, wpfgfx, vcruntime …) NEBEN die
         EXE. Der Installer nimmt nur die EXE mit — die Anwendung startet dann
         gar nicht mehr (DllNotFoundException tief in WindowsBase). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\MSDesk.ico" />
    <Content Include="Assets\TabIcons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Hilfe\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
